<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="description" content="PROFFLORD - Free Fire gaming, tutorials, tips, tricks, gameplay and OG SAYAN content.">
  <meta name="keywords" content="PROFFLORD, Free Fire, OG SAYAN, gaming, Free Fire tips, Free Fire tutorials">
  <meta name="author" content="PROFFLORD">

  <meta property="og:title" content="PROFFLORD | Free Fire Gaming">
  <meta property="og:description" content="Watch, learn and join the PROFFLORD squad.">
  <meta property="og:type" content="website">

  <title>PROFFLORD | Free Fire Gaming</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #070707;
      color: white;
      line-height: 1.6;
      overflow-x: hidden;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .container {
      width: min(1100px, 92%);
      margin: auto;
    }

    /* NAVIGATION */
    header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(5, 5, 5, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid #252525;
    }

    nav {
      min-height: 70px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .logo {
      font-size: 25px;
      font-weight: 1000;
      letter-spacing: 2px;
    }

    .logo span {
      color: #ff2020;
    }

    .nav-links {
      display: flex;
      gap: 22px;
      list-style: none;
      font-weight: 700;
      font-size: 14px;
    }

    .nav-links a:hover {
      color: #ff3030;
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      text-align: center;
      padding: 110px 0 70px;

      background:
        radial-gradient(
          circle at 50% 20%,
          rgba(255, 25, 25, 0.24),
          transparent 35%
        ),
        linear-gradient(
          135deg,
          #090909,
          #120000 50%,
          #050505
        );
    }

    .hero .container {
      max-width: 900px;
    }

    .eyebrow {
      color: #ff3535;
      font-weight: 900;
      letter-spacing: 4px;
      text-transform: uppercase;
    }

    h1 {
      font-size: clamp(48px, 12vw, 105px);
      line-height: 0.95;
      margin: 12px 0;
      text-shadow: 0 0 30px rgba(255, 20, 20, 0.35);
    }

    h1 span {
      color: #ff2020;
    }

    .hero h2 {
      font-size: clamp(20px, 4vw, 34px);
      letter-spacing: 5px;
      margin-bottom: 18px;
    }

    .hero p {
      max-width: 650px;
      margin: 0 auto 30px;
      color: #cfcfcf;
      font-size: 17px;
    }

    /* BUTTONS */
    .buttons {
      display: flex;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 15px 24px;
      border-radius: 8px;
      font-weight: 900;
      border: 1px solid #ff2525;
      transition: 0.25s;
      cursor: pointer;
    }

    .btn-primary {
      background: #ff2020;
      box-shadow: 0 10px 35px rgba(255, 0, 0, 0.25);
    }

    .btn-secondary {
      background: #111;
    }

    .btn:hover {
      transform: translateY(-3px);
      filter: brightness(1.15);
    }

    /* SECTIONS */
    section {
      padding: 85px 0;
    }

    .section-title {
      text-align: center;
      font-size: 38px;
      margin-bottom: 12px;
    }

    .section-title span {
      color: #ff2020;
    }

    .section-sub {
      text-align: center;
      color: #aaa;
      max-width: 650px;
      margin: 0 auto 45px;
    }

    /* ABOUT */
    .about-grid,
    .stats,
    .video-grid,
    .social-grid {
      display: grid;
      gap: 18px;
    }

    .about-grid {
      grid-template-columns: 1.3fr 1fr;
    }

    .card {
      background: linear-gradient(145deg, #111, #0a0a0a);
      border: 1px solid #252525;
      border-radius: 14px;
      padding: 28px;
    }

    .card h3 {
      margin-bottom: 10px;
      color: #ff3030;
    }

    .card p {
      color: #bdbdbd;
    }

    .stats {
      grid-template-columns: repeat(3, 1fr);
      margin-top: 18px;
    }

    .stat {
      text-align: center;
    }

    .stat strong {
      display: block;
      font-size: 35px;
      color: #ff2424;
    }

    .stat small {
      color: #aaa;
    }

    /* VIDEOS */
    .videos {
      background: #0b0b0b;
    }

    .video-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .video-card {
      overflow: hidden;
      padding: 0;
    }

    .video-thumb {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      background: #181818;
    }

    .video-info {
      padding: 20px;
    }

    .video-info h3 {
      font-size: 18px;
      margin-bottom: 8px;
    }

    .video-info p {
      font-size: 14px;
      margin-bottom: 15px;
    }

    .watch {
      display: inline-block;
      color: #ff3030;
      font-weight: 900;
    }

    /* SOCIALS */
    .social-grid {
      grid-template-columns: 1fr 1fr;
    }

    .social {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .social strong {
      font-size: 20px;
    }

    .social small {
      display: block;
      color: #aaa;
    }

    /* CTA */
    .cta {
      text-align: center;
      background:
        linear-gradient(
          135deg,
          #160000,
          #090909
        );
    }

    .cta p {
      max-width: 650px;
      margin: 0 auto 25px;
      color: #c9c9c9;
    }

    /* BADGE */
    .badge {
      display: inline-block;
      border: 1px solid #ff3030;
      color: #ff3030;
      border-radius: 999px;
      padding: 6px 12px;
      font-size: 12px;
      font-weight: 900;
      margin-bottom: 15px;
    }

    /* FOOTER */
    footer {
      padding: 30px 0;
      text-align: center;
      border-top: 1px solid #222;
      color: #777;
      font-size: 14px;
    }

    /* MOBILE */
    @media (max-width: 800px) {

      .nav-links {
        display: none;
      }

      .about-grid,
      .video-grid,
      .social-grid {
        grid-template-columns: 1fr;
      }

      .stats {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (max-width: 480px) {

      section {
        padding: 65px 0;
      }

      .hero {
        min-height: 92vh;
      }

      .stats strong {
        font-size: 27px;
      }

      .card {
        padding: 22px;
      }

      .btn {
        width: 100%;
      }
    }
  </style>
</head>

