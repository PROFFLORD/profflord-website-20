<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>PROFFLORD | Free Fire Gaming</title>

  <meta name="description" content="Welcome to PROFFLORD — Free Fire gaming, rush gameplay, tips, tricks, tutorials and entertaining gaming content by OG SAYAN.">
  <meta name="keywords" content="PROFFLORD, Free Fire, OG SAYAN, Free Fire gaming, Free Fire tips, Free Fire tutorials">
  <meta name="author" content="PROFFLORD">

  <meta property="og:title" content="PROFFLORD | Free Fire Gaming">
  <meta property="og:description" content="Free Fire gaming, rush gameplay, tips, tricks and tutorials.">
  <meta property="og:type" content="website">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #050505;
      color: white;
      line-height: 1.6;
    }

    /* NAVBAR */
    nav {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(0, 0, 0, 0.95);
      border-bottom: 1px solid #222;
      padding: 15px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 25px;
      font-weight: 900;
      color: #ff2020;
      letter-spacing: 2px;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 25px;
    }

    nav ul li a {
      color: white;
      text-decoration: none;
      font-weight: bold;
      transition: 0.3s;
    }

    nav ul li a:hover {
      color: #ff2020;
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 120px 20px 60px;

      background:
        radial-gradient(circle at center, #420000 0%, #120000 35%, #050505 70%);
    }

    .hero-content {
      max-width: 900px;
    }

    .welcome {
      color: #aaa;
      font-size: 18px;
      letter-spacing: 5px;
      text-transform: uppercase;
    }

    .hero h1 {
      font-size: clamp(55px, 12vw, 130px);
      font-weight: 1000;
      color: #ff2020;
      text-shadow:
        0 0 10px #ff2020,
        0 0 30px rgba(255, 0, 0, 0.5);
      letter-spacing: 5px;
      margin: 5px 0;
    }

    .hero h2 {
      font-size: clamp(22px, 5vw, 45px);
      letter-spacing: 4px;
    }

    .hero p {
      max-width: 700px;
      margin: 20px auto;
      color: #ccc;
      font-size: 18px;
    }

    .buttons {
      margin-top: 30px;
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 14px 25px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
      transition: 0.3s;
    }

    .btn-red {
      background: #ff2020;
      color: white;
      box-shadow: 0 0 20px rgba(255, 0, 0, 0.35);
    }

    .btn-red:hover {
      transform: translateY(-3px);
      background: #d90000;
    }

    .btn-dark {
      background: #151515;
      border: 1px solid #444;
      color: white;
    }

    .btn-dark:hover {
      border-color: #ff2020;
      color: #ff2020;
    }

    /* GENERAL */
    section {
      padding: 90px 7%;
    }

    .section-title {
      text-align: center;
      margin-bottom: 50px;
    }

    .section-title h2 {
      font-size: 40px;
      color: #ff2020;
    }

    .section-title p {
      color: #999;
    }

    /* ABOUT */
    .about {
      background: #090909;
    }

    .about-box {
      max-width: 950px;
      margin: auto;
      text-align: center;
    }

    .about-box h3 {
      font-size: 32px;
      margin-bottom: 15px;
    }

    .about-box h3 span {
      color: #ff2020;
    }

    .about-box p {
      color: #bbb;
      font-size: 17px;
      margin-bottom: 30px;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 35px;
    }

    .stat {
      background: #111;
      border: 1px solid #222;
      padding: 25px;
      border-radius: 12px;
    }

    .stat h4 {
      color: #ff2020;
      font-size: 25px;
    }

    .stat p {
      margin: 0;
      font-size: 14px;
    }

    /* VIDEOS */
    .videos {
      background: #050505;
    }

    .update-note {
      max-width: 900px;
      margin: -20px auto 40px;
      padding: 15px;
      border-left: 4px solid #ff2020;
      background: #101010;
      color: #bbb;
      text-align: center;
      border-radius: 5px;
    }

    .video-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
      max-width: 1200px;
      margin: auto;
    }

    .video-card {
      background: #101010;
      border: 1px solid #252525;
      border-radius: 12px;
      overflow: hidden;
      transition: 0.3s;
    }

    .video-card:hover {
      transform: translateY(-7px);
      border-color: #ff2020;
      box-shadow: 0 10px 30px rgba(255, 0, 0, 0.15);
    }

    .video-card img {
      width: 100%;
      display: block;
      aspect-ratio: 16/9;
      object-fit: cover;
    }

    .video-info {
      padding: 20px;
    }

    .video-info h3 {
      margin-bottom: 15px;
      font-size: 20px;
    }

    .watch {
      color: #ff2020;
      text-decoration: none;
      font-weight: bold;
    }

    /* SOCIAL */
    .socials {
      background: #090909;
    }

    .social-grid {
      display: flex;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .social-card {
      width: 280px;
      padding: 30px;
      background: #111;
      border: 1px solid #222;
      border-radius: 12px;
      text-align: center;
      transition: 0.3s;
    }

    .social-card:hover {
      border-color: #ff2020;
      transform: translateY(-5px);
    }

    .social-card h3 {
      font-size: 25px;
      margin-bottom: 10px;
    }

    .social-card p {
      color: #999;
      margin-bottom: 20px;
    }

    /* CTA */
    .cta {
      text-align: center;
      background:
        linear-gradient(rgba(80,0,0,0.55), rgba(5,5,5,0.95)),
        #080808;
    }

    .cta h2 {
      font-size: clamp(30px, 6vw, 55px);
      margin-bottom: 15px;
    }

    .cta p {
      color: #bbb;
      margin-bottom: 25px;
    }

    /* FOOTER */
    footer {
      padding: 30px 20px;
      background: #000;
      text-align: center;
      border-top: 1px solid #222;
    }

    footer .footer-logo {
      color: #ff2020;
      font-size: 25px;
      font-weight: 900;
      letter-spacing: 2px;
      margin-bottom: 10px;
    }

    footer p {
      color: #777;
      font-size: 14px;
    }

    /* MOBILE */
    @media (max-width: 800px) {

      nav {
        padding: 13px 5%;
      }

      .logo {
        font-size: 20px;
      }

      nav ul {
        gap: 12px;
      }

      nav ul li a {
        font-size: 12px;
      }

      .hero {
        padding-top: 120px;
      }

      .hero h1 {
        letter-spacing: 2px;
      }

      section {
        padding: 70px 5%;
      }

      .stats {
        grid-template-columns: 1fr;
      }

      .video-grid {
        grid-template-columns: 1fr;
      }

      .section-title h2 {
        font-size: 32px;
      }
    }

    @media (max-width: 500px) {

      nav ul {
        gap: 8px;
      }

      nav ul li a {
        font-size: 10px;
      }

      .welcome {
        font-size: 13px;
        letter-spacing: 3px;
      }

      .hero p {
        font-size: 15px;
      }

      .btn {
        width: 100%;
        max-width: 280px;
      }
    }
  </style>
</head>

